# ========================================================
# PostureFit - Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Cloud Configuration
# Pre-configured with the live project (includes 25 curated exercises, 5 challenges, and seed data)
# If omitted or cleared, PostureFit automatically falls back to its built-in in-memory offline store!
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin Secret
ADMIN_SECRET_KEY=posturefit_super_secret_admin_token_2026

# Gamification Points Rules (Enforced securely on backend)
POINTS_EXERCISE_COMPLETION=20
POINTS_BREAK_COMPLETION=10
POINTS_DAILY_GOAL_BONUS=50
POINTS_STREAK_7_DAY_BONUS=100
